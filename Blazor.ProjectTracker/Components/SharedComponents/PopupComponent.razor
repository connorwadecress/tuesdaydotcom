<MudDialog MaxWidth="MaxWidth.Medium" FullWidth="true">
    <DialogContent>

        <MudText Typo="Typo.h5">New Board</MudText>

        <MudTextField @bind-Value="_model.Name" Label="Name" Required="true" Counter="20"/>
        <MudTextField @bind-Value="_model.Description" Label="Description" Lines="4"/>

        <MudDatePicker Label="Deadline Date"
                       @bind-Date="_model.DeadlineDate"
                       DateFormat="dddd, dd MMM yyyy"
                       Clearable="true"/>

        <MudSelect @bind-Value="_model.Status" Label="Status">
            <MudSelectItem Value="@("Active")">Active</MudSelectItem>
            <MudSelectItem Value="@("Completed")">Completed</MudSelectItem>
            <MudSelectItem Value="@("On Hold")">On Hold</MudSelectItem>
        </MudSelect>

    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Cancel</MudButton>
        <MudButton OnClick="Save" Color="Color.Primary" Variant="Variant.Filled">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public Project Model { get; set; } = new();

    private Board _model = new();

    protected override void OnInitialized()
    {
        _model = new Board
        {
            Name = Model.Name,
            Description = Model.Description,
            DateCreated = Model.DateCreated,
            DeadlineDate = Model.DeadlineDate,
            Status = Model.Status
        };
    }

    private void Cancel() => MudDialog.Cancel();

    private void Save() => MudDialog.Close(DialogResult.Ok(_model));
}